# Application
APP_NAME="Hospital Readmission Prediction API"
VERSION="1.0.0"
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
# Local development
DATABASE_URL=postgresql+asyncpg://vishwa@localhost:5432/readmission_db
DATABASE_URL_SYNC=postgresql://vishwa@localhost:5432/readmission_db

# AWS RDS (Production) - Update these when migrating to AWS
# DATABASE_URL=postgresql+asyncpg://username:password@your-rds-endpoint.region.rds.amazonaws.com:5432/readmission_db
# DATABASE_URL_SYNC=postgresql://username:password@your-rds-endpoint.region.rds.amazonaws.com:5432/readmission_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# ML Model
MODEL_PATH=../best_model.pkl
FEATURE_IMPORTANCE_PATH=../best_model_feature_importance.csv
